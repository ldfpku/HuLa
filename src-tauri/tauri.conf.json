{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SMJ",
  "version": "../package.json",
  "identifier": "com.smjtools.desktop",
  "mainBinaryName": "SMJ",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:6130"
  },
  "bundle": {
    "category": "SocialNetworking",
    "copyright": "© 江苏斯米伽石油装备有限公司",
    "resources": [
      "tray",
      "configuration",
      "draco"
    ],
    "createUpdaterArtifacts": true,
    "active": true,
    "icon": [
      "icons/desktop/32x32.png",
      "icons/desktop/128x128.png",
      "icons/desktop/128x128@2x.png",
      "icons/desktop/icon.icns",
      "icons/desktop/icon.ico",
      "icons/desktop/icon.png",
      "icons/desktop/Square30x30Logo.png",
      "icons/desktop/Square44x44Logo.png",
      "icons/desktop/Square71x71Logo.png",
      "icons/desktop/Square89x89Logo.png",
      "icons/desktop/Square107x107Logo.png",
      "icons/desktop/Square142x142Logo.png",
      "icons/desktop/Square150x150Logo.png",
      "icons/desktop/Square284x284Logo.png",
      "icons/desktop/Square310x310Logo.png",
      "icons/desktop/StoreLogo.png"
    ],
    "windows": {},
    "macOS": {},
    "publisher": "江苏斯米伽石油装备有限公司",
    "shortDescription": "SMJ 即时通讯"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: blob: https: http:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http: wss: ws:; media-src 'self' data: https: http: blob:; frame-src 'self' https: http: about:; worker-src 'self' blob:",
      "capabilities": [
        "default-capability",
        "mobile-capability",
        "desktop-capability"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1NkNENEZFNzg1MjVFMEEKUldRS1hsSjQvdFJzbGJXcnNPNXBYZ2RlTmlRRFZYYVI3YXhiWGpYZXFwVUtucThZUnJHUGw5dVUK",
      "endpoints": [
        "https://mail.smjtools.com/api/desktop/update/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
